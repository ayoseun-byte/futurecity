# -----------------------------------------------------------------------------
# Orki PSP & Merchant Portal - Frontend Environment Configuration
# -----------------------------------------------------------------------------

# Backend API Base URL (Pointing to Orki PSP Backend)
VITE_API_BASE_URL=http://localhost:8000/v1
VITE_PSP_API_URL=http://localhost:8000

# Web3Auth Embedded Wallets (configure EVM and Solana chains in its dashboard)
VITE_WEB3AUTH_CLIENT_ID=
VITE_WEB3AUTH_NETWORK=sapphire_devnet

# ZeroDev ERC-4337 Account Abstraction (testnet project only)
VITE_ZERODEV_PROJECT_ID=
VITE_ZERODEV_RPC_URL=

# Environment Mode: sandbox | production
VITE_ORKI_ENV=sandbox

# Hosted checkout app (Merchant_Public_Payment_Frontend)
VITE_HOSTED_DOMAIN=http://localhost:3000

# Testnet RPC providers
VITE_BASE_CHAIN_ID=84532
VITE_BASE_RPC_URL=https://sepolia.base.org
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Compliance & Identity Verification (Sumsub Sandbox)
VITE_SUMSUB_ENABLED=true
