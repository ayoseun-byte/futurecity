# -----------------------------------------------------------------------------
# Orki PSP & Merchant Portal - Frontend Environment Configuration
# -----------------------------------------------------------------------------

# Backend API Base URL (Pointing to Orki PSP Backend)
VITE_API_BASE_URL=http://localhost:8000/v1

# Environment Mode: sandbox | production
VITE_ORKI_ENV=sandbox

# Hosted Checkout & Onboarding Domain (Default hosted window for passkeys & payments)
VITE_HOSTED_DOMAIN=https://pay.orki.com

# Web3 / RPC Providers (Optional for direct client telemetry)
VITE_BASE_CHAIN_ID=8453
VITE_BASE_RPC_URL=https://mainnet.base.org
VITE_SOLANA_CLUSTER=mainnet-beta
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Compliance & Identity Verification (Sumsub Sandbox)
VITE_SUMSUB_ENABLED=true
